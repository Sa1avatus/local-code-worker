#LLM_PROVIDER=ollama
#LLM_BASE_URL=http://localhost:11434
#LLM_MODEL=qwen2.5-coder:3b
#LLM_API_KEY_ENV=
LLM_TIMEOUT_SECONDS=600
LLM_CONNECT_TIMEOUT_SECONDS=30
LLM_READ_TIMEOUT_SECONDS=600
LLM_NUM_CTX=16384
LLM_TEMPERATURE=0
LLM_STREAM=true
LLM_JSON_MODE=auto
LLM_MAX_OUTPUT_CHARACTERS=100000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_KEEP_ALIVE=30m

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-14b:free
LLM_API_KEY_ENV=OPENROUTER_API_KEY
LLM_JSON_MODE=prompt-only
LLM_STREAM=true

OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Local Code Worker

# Legacy Ollama settings remain supported.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=600

WORKER_COMMAND_TIMEOUT_SECONDS=300
WORKER_REPORTS_DIRECTORY=.local-worker/reports
WORKER_BACKUPS_DIRECTORY=.local-worker/backups
WORKER_STATE_DIRECTORY=.local-worker/state

# Gateway routing. GATEWAY_ROUTING_MODE also accepts observe_only and router for compatibility.
GATEWAY_ROUTING_MODE=legacy
GATEWAY_LOCAL_THRESHOLD=0.3
GATEWAY_STRONG_THRESHOLD=0.7
GATEWAY_CANARY_PERCENT=10
GATEWAY_MAX_ESCALATIONS_PER_LEASE=2
# Parallel slots per tier for the Ollama runner. Ollama sizes the runner
# context as num_ctx * num_parallel, so keep 1 for large models / long contexts
# and raise it only for small models that must serve concurrent requests.
GATEWAY_LOCAL_NUM_PARALLEL=1
GATEWAY_MID_NUM_PARALLEL=1
GATEWAY_STRONG_NUM_PARALLEL=1
GATEWAY_RESPONSE_STATE_TTL_SECONDS=7200
GATEWAY_RESPONSE_STATE_MAX_ENTRIES=256
GATEWAY_ROUTELLM_ENABLED=false
GATEWAY_ROUTELLM_CHECKPOINT_PATH=

# HTTP request body limits. Defaults apply when these variables are omitted.
LCW_MAX_UI_REQUEST_BYTES=1048576
LCW_MAX_RESPONSES_REQUEST_BYTES=16777216
